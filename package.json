{
  "name": "standard-slugify",
  "version": "4.1.0",
  "description": "Converts a string into a slug safe for URLs and filenames. Supports Latin, Greek and Cyrillic scripts.",
  "keywords": [
    "filename",
    "slug",
    "slugify",
    "transliterate",
    "uri",
    "urify",
    "url",
    "urlify"
  ],
  "homepage": "https://github.com/rtomrud/standard-slugify#readme",
  "bugs": {
    "url": "https://github.com/rtomrud/standard-slugify/issues"
  },
  "license": "MIT",
  "author": "Artem Rudenko <rtomrud@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rtomrud/standard-slugify.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "check": "vp check",
    "prepublishOnly": "vp run build",
    "prepare": "vp config"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vite-plus": "^1.6.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.6.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": "12.2.2",
      "onFail": "download"
    }
  }
}
